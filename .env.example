NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo servidor — nunca en el navegador. Panel de Supabase → Project Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=

# Panel de Hotmart → Herramientas → Webhook → pestaña Autenticación
HOTMART_HOTTOK=

# resend.com → API Keys (después de verificar tu dominio propio)
RESEND_API_KEY=

# Links de checkout de Hotmart de cada plan (Producto → Precios → copiar el link de cada oferta)
NEXT_PUBLIC_HOTMART_CHECKOUT_URL_MENSUAL=
NEXT_PUBLIC_HOTMART_CHECKOUT_URL_ANUAL=

# Secreto compartido con el cron de Supabase (pg_cron) que dispara los recordatorios de eventos.
# Generado una sola vez por el agente — mismo valor que el cron job "send-event-reminders" en Supabase.
CRON_SECRET=

# console.cloud.google.com → habilitar "YouTube Data API v3" → Credenciales → Crear clave de API
YOUTUBE_API_KEY=

# developer.spotify.com/dashboard → tu app → Settings
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Correos con acceso al panel admin (botón "Live ahora"), separados por coma
ADMIN_EMAILS=

# PostHog → Project Settings → General. La project key es pública por diseño (segura en el navegador).
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
# Mismas credenciales, leídas en el servidor (webhook de Hotmart) para el evento plan_actualizado.
POSTHOG_KEY=
POSTHOG_HOST=
